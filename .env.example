# Server-side only. Copy to .env or cloudflare-pages/.dev.vars for local Wrangler.
# Never commit filled values. Deployed Cloudflare Pages reads bindings with these names.
# LUMAPRINTS_ENVIRONMENT must be sandbox or production.
LUMAPRINTS_API_KEY=
LUMAPRINTS_API_SECRET=
LUMAPRINTS_ENVIRONMENT=sandbox
LUMAPRINTS_ADMIN_TOKEN=
