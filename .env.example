# Local names only. Copy to .env, which is gitignored. Do not commit values.
# Set the same names on Cloudflare Pages project bitter-buffalo-art only after Clyde approves that environment.
# SQUARE_ENVIRONMENT must stay sandbox. LUMAPRINTS_API_BASE must stay on the sandbox host.

SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_BASE=https://connect.squareupsandbox.com
SQUARE_VERSION=2026-09-16
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

LUMAPRINTS_API_KEY=
LUMAPRINTS_API_SECRET=
LUMAPRINTS_ENVIRONMENT=
LUMAPRINTS_ADMIN_TOKEN=
LUMAPRINTS_API_BASE=https://us.api-sandbox.lumaprints.com/api/v1
LUMAPRINTS_STORE_ID=
LUMAPRINTS_WEBHOOK_USER=
LUMAPRINTS_WEBHOOK_PASSWORD=
PRINT_FULFILLMENT_MODE=

PRINT_MASTER_URL_SECRET=
# PRINTS_DB and PRINT_MASTERS are Cloudflare bindings, not shell variables.
